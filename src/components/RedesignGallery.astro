---
import { page, asset } from '../utils/paths.js';

const images = [
  asset('/images/gallery-1.jpeg'),
  asset('/images/gallery-2.jpeg'),
  asset('/images/gallery-3.jpeg'),
  asset('/images/gallery-4.jpeg'),
  asset('/images/gallery-5.jpeg'),
  asset('/images/gallery-6.jpeg'),
  asset('/images/gallery-7.jpeg'),
  asset('/images/gallery-8.jpeg'),
];
---

<section class="gallery-redesign section">
  <div class="container">
    <div class="gallery__header reveal">
      <p class="section-label">Galerie</p>
      <h2 class="section-title">Okamžiky v pohybu</h2>
      <div class="divider"></div>
      <p class="section-subtitle">
        Každá fotka zachycuje okamžik, kdy se historie setkává s přítomností. 
        Najeďte myší a sledujte, jak ožívá barva.
      </p>
    </div>
    
    <div class="gallery__grid stagger">
      {images.map((src, index) => (
        <div class={`gallery__item gallery__item--${(index % 4) + 1}`}>
          <img src={src} alt={`Vystoupení ${index + 1}`} loading="lazy" />
        </div>
      ))}
    </div>
    
    <div class="gallery__cta reveal">
      <a href={page('/galerie')} class="btn btn--outline btn--arrow">
        Zobrazit celou galerii
      </a>
    </div>
  </div>
</section>

<style>
  .gallery-redesign {
    background: var(--bg-deep);
    padding: clamp(5rem, 12vw, 10rem) 0;
  }
  
  .gallery__header {
    margin-bottom: 5rem;
    max-width: 600px;
  }
  
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  
  .gallery__item {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    cursor: pointer;
    aspect-ratio: 1;
  }
  
  .gallery__item--1 {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: auto;
  }
  
  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) brightness(0.8);
    transition: filter 0.6s var(--ease), transform 0.6s var(--ease);
  }
  
  .gallery__item:hover img {
    filter: grayscale(0%) brightness(1);
    transform: scale(1.05);
  }
  
  .gallery__cta {
    text-align: center;
  }
  
  @media (max-width: 900px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    
    .gallery__item--1 {
      grid-column: span 2;
      grid-row: span 1;
    }
  }
</style>
