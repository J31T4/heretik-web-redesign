---
import { page, asset } from '../utils/paths.js';
---

<header class="header-redesign">
  <div class="container header__inner">
    <a href={page('/')} class="header__brand">
      <img src={asset('/logo.svg')} alt="SHŠ Heretik" class="header__logo" />
      <span class="header__text">SHŠ Heretik</span>
    </a>
    <nav class="header__nav">
      <a href={page('/o-nas')} class="header__link">O nás</a>
      <a href={page('/galerie')} class="header__link">Galerie</a>
      <a href={page('/akce')} class="header__link">Akce</a>
      <a href={page('/kontakt')} class="header__link">Kontakt</a>
    </nav>
    <a href={page('/kontakt')} class="btn btn--outline">Domluvit vystoupení</a>
  </div>
</header>

<style>
  .header-redesign {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(14, 11, 8, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: background 0.3s var(--ease);
  }
  
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem clamp(1.5rem, 4vw, 3rem);
    max-width: var(--container);
    margin: 0 auto;
    gap: 2rem;
  }
  
  .header__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }
  
  .header__logo {
    height: 56px;
    width: auto;
    filter: drop-shadow(0 0 12px rgba(196, 145, 58, 0.3));
  }
  
  .header__text {
    letter-spacing: 0.02em;
  }
  
  .header__nav {
    display: flex;
    gap: 2.5rem;
  }
  
  .header__link {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    text-transform: uppercase;
    position: relative;
    padding: 0.5rem 0;
  }
  
  .header__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s var(--ease);
  }
  
  .header__link:hover {
    color: var(--text-primary);
  }
  
  .header__link:hover::after {
    width: 100%;
  }
  
  @media (max-width: 900px) {
    .header__nav {
      display: none;
    }
  }
</style>
