---
import { page } from '../utils/paths.js';
---

<section class="cta-redesign section">
  <div class="container">
    <div class="cta__inner reveal">
      <p class="section-label">Spolupráce</p>
      <h2 class="cta__title">Chcete nás na vaší akci?</h2>
      <p class="cta__subtitle">
        Ať už plánujete městskou slavnost, historický den, ples, firemní večírek 
        nebo rodinnou oslavu – rádi pro vás připravíme nezapomenutelné vystoupení.
      </p>
      <a href={page('/kontakt')} class="btn btn--primary btn--large btn--arrow">
        Domluvit vystoupení
      </a>
    </div>
  </div>
</section>

<style>
  .cta-redesign {
    background: var(--bg);
    padding: clamp(6rem, 14vw, 12rem) 0;
    position: relative;
    overflow: hidden;
  }
  
  .cta-redesign::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(196, 145, 58, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
  }
  
  .cta__inner {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  
  .cta__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 2rem;
    color: var(--text-primary);
  }
  
  .cta__subtitle {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }
</style>
