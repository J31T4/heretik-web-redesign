---
import RedesignLayout from '../layouts/RedesignLayout.astro';
import RedesignHeader from '../components/RedesignHeader.astro';
import RedesignFooter from '../components/RedesignFooter.astro';
import { page } from '../utils/paths.js';
---

<RedesignLayout title="Akce">
  <RedesignHeader />
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="section-label reveal">Akce</p>
        <h1 class="page-title reveal">Naše vystoupení<br/>a události</h1>
        <div class="divider reveal"></div>
      </div>
    </section>

    <section class="events section">
      <div class="container container--narrow">
        <div class="event__block reveal">
          <p class="event__label">Nadcházející</p>
          <h2 class="event__title">Nadcházející akce</h2>
          <p class="event__text">
            Kalendář nadcházejících akcí připravujeme. Sledujte nás nebo nás kontaktujte 
            pro informace o aktuálních vystoupeních.
          </p>
        </div>

        <div class="event__block reveal">
          <p class="event__label">Historie</p>
          <h2 class="event__title">Proběhlé akce</h2>
          <p class="event__text">
            V průběhu roku vystupujeme na různých akcích po celé České republice. 
            Ukázky z našich vystoupení najdete v <a href={page('/galerie')} class="event__link">galerii</a>.
          </p>
        </div>

        <div class="event__block reveal">
          <p class="event__label">Spolupráce</p>
          <h2 class="event__title">Chcete nás na vaší akci?</h2>
          <p class="event__text">
            Rádi pro vás připravíme vystoupení na míru. Kontaktujte nás a domluvíme 
            detaily.
          </p>
          <p class="event__text">
            <a href={page('/kontakt')} class="btn btn--primary btn--arrow">Domluvit vystoupení</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <RedesignFooter />
</RedesignLayout>

<style>
  .page-hero {
    background: var(--bg);
    padding: 10rem 0 4rem;
  }
  
  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2rem;
  }
  
  .events {
    background: var(--bg-deep);
    padding: clamp(4rem, 10vw, 8rem) 0;
  }
  
  .event__block {
    margin-bottom: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--border);
  }
  
  .event__block:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  
  .event__label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  
  .event__title {
    font-size: 2rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }
  
  .event__text {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }
  
  .event__link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  
  .event__link:hover {
    color: var(--accent-light);
  }
  
  @media (max-width: 768px) {
    .page-hero {
      padding: 8rem 0 3rem;
    }
    
    .event__block {
      margin-bottom: 3rem;
      padding-bottom: 3rem;
    }
  }
</style>
