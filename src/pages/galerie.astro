---
import RedesignLayout from '../layouts/RedesignLayout.astro';
import RedesignHeader from '../components/RedesignHeader.astro';
import RedesignFooter from '../components/RedesignFooter.astro';
import { asset } from '../utils/paths.js';

const images = [
  asset('/images/gallery-1.jpeg'),
  asset('/images/gallery-2.jpeg'),
  asset('/images/gallery-3.jpeg'),
  asset('/images/gallery-4.jpeg'),
  asset('/images/gallery-5.jpeg'),
  asset('/images/gallery-6.jpeg'),
  asset('/images/gallery-7.jpeg'),
  asset('/images/gallery-8.jpeg'),
];
---

<RedesignLayout title="Galerie">
  <RedesignHeader />
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="section-label reveal">Galerie</p>
        <h1 class="page-title reveal">Okamžiky<br/>v pohybu</h1>
        <div class="divider reveal"></div>
        <p class="page-subtitle reveal">
          Každá fotka zachycuje okamžik, kdy se historie setkává s přítomností. 
          Najeďte myší a sledujte, jak ožívá barva.
        </p>
      </div>
    </section>

    <section class="gallery section">
      <div class="container">
        <div class="gallery__grid stagger">
          {images.map((src, index) => (
            <div class="gallery__item">
              <img src={src} alt={`Vystoupení ${index + 1}`} loading="lazy" />
            </div>
          ))}
        </div>

        <div class="gallery__info reveal">
          <h2 class="gallery__info-title">Videa připravujeme</h2>
          <p class="gallery__info-text">
            Pracujeme na videosekvencích z našich vystoupení. Brzy je zde přidáme, 
            abyste si mohli užít atmosféru i z pohyblivých záznamů.
          </p>
        </div>
      </div>
    </section>
  </main>
  <RedesignFooter />
</RedesignLayout>

<style>
  .page-hero {
    background: var(--bg);
    padding: 10rem 0 4rem;
  }
  
  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2rem;
  }
  
  .page-subtitle {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 560px;
  }
  
  .gallery {
    background: var(--bg-deep);
    padding: clamp(4rem, 10vw, 8rem) 0;
  }
  
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 5rem;
  }
  
  .gallery__item {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    cursor: pointer;
    aspect-ratio: 1;
  }
  
  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) brightness(0.8);
    transition: filter 0.6s var(--ease), transform 0.6s var(--ease);
  }
  
  .gallery__item:hover img {
    filter: grayscale(0%) brightness(1);
    transform: scale(1.05);
  }
  
  .gallery__info {
    text-align: center;
    padding: 4rem 3rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 4px;
    max-width: 700px;
    margin: 0 auto;
  }
  
  .gallery__info-title {
    font-size: 2rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }
  
  .gallery__info-text {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 auto;
  }
  
  @media (max-width: 900px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
  
  @media (max-width: 768px) {
    .page-hero {
      padding: 8rem 0 3rem;
    }
  }
</style>
